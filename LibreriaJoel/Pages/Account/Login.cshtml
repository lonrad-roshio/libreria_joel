@page
@model LibreriaJoel.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Iniciar sesión</h1>
                <p class="text-muted">Ingresa con tu cuenta de Librería JOEL.</p>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Datos.NombreUsuario" class="form-label">Usuario</label>
                        <input asp-for="Datos.NombreUsuario"
                               class="form-control"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               autofocus />
                        <span asp-validation-for="Datos.NombreUsuario" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Datos.Contrasena" class="form-label">Contraseña</label>
                        <input asp-for="Datos.Contrasena"
                               class="form-control"
                               autocomplete="current-password" />
                        <span asp-validation-for="Datos.Contrasena" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primario w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
