@page "/Usuarios/Eliminar/{id:int}"
@model LibreriaJoel.Pages.Usuarios.DeleteModel
@{
    ViewData["Title"] = "Eliminar usuario";
}

<h1 class="h4 mb-3 text-danger">Eliminar usuario</h1>

<div class="card card-modulo">
    <div class="card-body">
        <p>¿Está seguro de que desea eliminar al usuario <strong>@Model.Usuario!.NombreUsuario</strong>?</p>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Usuario.IdUsuario" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
