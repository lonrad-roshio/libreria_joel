@page "/Usuarios"
@model LibreriaJoel.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1" style="color:var(--azul-profesional)">Control de usuarios</h1>
        <p class="text-muted mb-0">Administra cuentas, datos y permisos.</p>
    </div>
    <a asp-page="Create" class="btn btn-primario">+ Registrar usuario</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="Filtro" value="@Model.Filtro" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-arena">Buscar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white">
        <thead>
            <tr>
                <th>#</th>
                <th>Usuario</th>
                <th>Nombre</th>
                <th>Rol</th>
                <th>Dirección</th>
                <th>Celular</th>
                <th>NIT/CI</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model.Usuarios)
            {
                <tr>
                    <td>@usuario.IdUsuario</td>
                    <td>@usuario.NombreUsuario</td>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Rol</td>
                    <td>@usuario.Direccion</td>
                    <td>@usuario.Celular</td>
                    <td>@usuario.NitCi</td>
                    <td class="text-end">
                        <a asp-page="Details" asp-route-id="@usuario.IdUsuario" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-page="Edit" asp-route-id="@usuario.IdUsuario" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-page="Delete" asp-route-id="@usuario.IdUsuario" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Usuarios.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-3">No hay usuarios registrados.</td></tr>
            }
        </tbody>
    </table>
</div>
