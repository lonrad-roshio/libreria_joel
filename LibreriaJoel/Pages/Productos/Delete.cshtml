@page "{id:int}"
@model LibreriaJoel.Pages.Productos.DeleteModel
@{
    ViewData["Title"] = "Eliminar producto";
}

<h1 class="h4 mb-3 text-danger">Eliminar producto</h1>

<div class="card card-modulo">
    <div class="card-body">
        <p>¿Está seguro de que desea eliminar el producto <strong>@Model.Producto!.Nombre</strong>?</p>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Producto.IdProducto" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
