@page
@model LibreriaJoel.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3" style="color:var(--azul-profesional)">Inventario de productos</h1>
    <a asp-page="Create" class="btn btn-primario">+ Nuevo producto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="Filtro" value="@Model.Filtro" class="form-control" placeholder="Buscar por nombre o marca..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-arena">Buscar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white">
        <thead>
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Lote</th>
                <th>Costo entrada</th>
                <th>Precio venta</th>
                <th>Stock</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model.Productos)
            {
                <tr class="@(Model.IdsStockBajo.Contains(producto.IdProducto) ? "table-danger" : "")">
                    <td>@producto.IdProducto</td>
                    <td>@producto.Nombre</td>
                    <td>@producto.Marca</td>
                    <td>@(producto.Lote ?? "-")</td>
                    <td>Bs. @producto.CostoEntrada.ToString("N2")</td>
                    <td>Bs. @producto.PrecioVenta.ToString("N2")</td>
                    <td>
                        @producto.Stock @producto.UnidadMedida
                        @if (Model.IdsStockBajo.Contains(producto.IdProducto))
                        {
                            <span class="badge badge-stock-bajo ms-1">Stock bajo</span>
                        }
                    </td>
                    <td>
                        @if (producto.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-page="Details" asp-route-id="@producto.IdProducto" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-page="Edit" asp-route-id="@producto.IdProducto" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-page="Delete" asp-route-id="@producto.IdProducto" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Productos.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-3">No hay productos registrados.</td></tr>
            }
        </tbody>
    </table>
</div>
