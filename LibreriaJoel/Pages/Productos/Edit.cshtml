@page "{id:int}"
@model LibreriaJoel.Pages.Productos.EditModel
@{
    ViewData["Title"] = "Editar producto";
}

<h1 class="h4 mb-3" style="color:var(--azul-profesional)">Editar producto</h1>

<div class="card card-modulo">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Producto.IdProducto" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Producto.Nombre" class="form-label">Nombre *</label>
                    <input asp-for="Producto.Nombre" class="form-control" />
                    <span asp-validation-for="Producto.Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Producto.Marca" class="form-label">Marca *</label>
                    <input asp-for="Producto.Marca" class="form-control" />
                    <span asp-validation-for="Producto.Marca" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Producto.Lote" class="form-label">Lote</label>
                    <input asp-for="Producto.Lote" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Producto.UnidadMedida" class="form-label">Unidad de medida</label>
                    <select asp-for="Producto.UnidadMedida" class="form-select">
                        <option value="UNIDAD">Unidad</option>
                        <option value="PAQUETE">Paquete</option>
                        <option value="CAJA">Caja</option>
                        <option value="HOJA">Hoja suelta</option>
                    </select>
                </div>
                @{
                    var margenActual = Model.Producto.CostoEntrada > 0
                        ? Math.Round((Model.Producto.PrecioVenta / Model.Producto.CostoEntrada - 1) * 100, 2)
                        : 0;
                }
                <div class="col-md-3 mb-3">
                    <label asp-for="Producto.CostoEntrada" class="form-label">Costo de entrada (Bs) *</label>
                    <input asp-for="Producto.CostoEntrada" id="inputCostoEntrada" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Producto.CostoEntrada" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="inputMargenGanancia" class="form-label">Margen de ganancia (%)</label>
                    <input type="number" id="inputMargenGanancia" class="form-control" step="0.01" value="@margenActual" />
                    <div class="form-text">Recalcula el precio de venta si lo cambias.</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Producto.PrecioVenta" class="form-label">Precio de venta (Bs) *</label>
                    <input asp-for="Producto.PrecioVenta" id="inputPrecioVenta" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Producto.PrecioVenta" class="text-danger"></span>
                    <div class="form-text">Editable manualmente (ej. para redondear).</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Producto.Stock" class="form-label">Stock *</label>
                    <input asp-for="Producto.Stock" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Producto.Stock" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Producto.FechaIngreso" class="form-label">Fecha de ingreso *</label>
                    <input asp-for="Producto.FechaIngreso" class="form-control" type="date" />
                </div>
                <div class="col-md-4 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="Producto.Estado" class="form-check-input" />
                        <label asp-for="Producto.Estado" class="form-check-label">Activo para la venta</label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primario">Guardar cambios</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/productos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            iniciarCalculoPrecioVenta('inputCostoEntrada', 'inputMargenGanancia', 'inputPrecioVenta');
        });
    </script>
}
