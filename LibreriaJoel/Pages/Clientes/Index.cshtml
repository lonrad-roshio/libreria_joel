@page
@model LibreriaJoel.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3" style="color:var(--azul-profesional)">Clientes</h1>
    <a asp-page="Create" class="btn btn-primario">+ Nuevo cliente</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="Filtro" value="@Model.Filtro" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-arena">Buscar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white">
        <thead>
            <tr>
                <th>#</th>
                <th>Nombre</th>
                <th>Dirección</th>
                <th>Celular</th>
                <th>NIT/CI</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model.Clientes)
            {
                <tr>
                    <td>@cliente.IdCliente</td>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Direccion</td>
                    <td>@cliente.Celular</td>
                    <td>@cliente.NitCi</td>
                    <td class="text-end">
                        <a asp-page="Details" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-page="Edit" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-page="Delete" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Clientes.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-3">No hay clientes registrados.</td></tr>
            }
        </tbody>
    </table>
</div>
