@page "{id:int}"
@model LibreriaJoel.Pages.Clientes.DeleteModel
@{
    ViewData["Title"] = "Eliminar cliente";
}

<h1 class="h4 mb-3 text-danger">Eliminar cliente</h1>

<div class="card card-modulo">
    <div class="card-body">
        <p>¿Está seguro de que desea eliminar al cliente <strong>@Model.Cliente!.Nombre</strong>?</p>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Cliente.IdCliente" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
