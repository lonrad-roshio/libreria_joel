@page
@model LibreriaJoel.Pages.Clientes.CreateModel
@{
    ViewData["Title"] = "Nuevo cliente";
}

<h1 class="h4 mb-3" style="color:var(--azul-profesional)">Registrar nuevo cliente</h1>

<div class="card card-modulo">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Cliente.Nombre" class="form-label">Nombre completo *</label>
                <input asp-for="Cliente.Nombre" class="form-control" />
                <span asp-validation-for="Cliente.Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Cliente.Direccion" class="form-label">Dirección</label>
                <input asp-for="Cliente.Direccion" class="form-control" />
                <span asp-validation-for="Cliente.Direccion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Cliente.Celular" class="form-label">Celular</label>
                <input asp-for="Cliente.Celular" class="form-control" />
                <span asp-validation-for="Cliente.Celular" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Cliente.NitCi" class="form-label">NIT / CI</label>
                <input asp-for="Cliente.NitCi" class="form-control" />
                <span asp-validation-for="Cliente.NitCi" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primario">Guardar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
