@page
@model LibreriaJoel.Pages.Ventas.IndexModel
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3" style="color:var(--azul-profesional)">Ventas</h1>
    <div>
        <a asp-page-handler="ExportarExcel" class="btn btn-arena">Exportar Excel (últimos 30 días)</a>
        <a asp-page="Create" class="btn btn-primario">+ Nueva venta</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="Fecha" value="@(Model.Fecha?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-arena">Filtrar por fecha</button>
    </div>
    <div class="col-auto">
        <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p class="fw-bold">Total del listado: Bs. @Model.TotalFiltrado.ToString("N2")</p>

<div class="table-responsive">
    <table class="table table-striped align-middle bg-white">
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Items</th>
                <th>Forma de pago</th>
                <th>Cajero</th>
                <th>Total</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venta in Model.Ventas)
            {
                <tr>
                    <td>@venta.IdVenta</td>
                    <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@(venta.Cliente?.Nombre ?? "N/D")</td>
                    <td>@venta.Detalle.Count</td>
                    <td>@venta.FormaPago</td>
                    <td>@venta.Cajero</td>
                    <td>Bs. @venta.Total.ToString("N2")</td>
                    <td class="text-end">
                        <a asp-page="Details" asp-route-id="@venta.IdVenta" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-page="Edit" asp-route-id="@venta.IdVenta" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-page="Delete" asp-route-id="@venta.IdVenta" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Ventas.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-3">No hay ventas registradas.</td></tr>
            }
        </tbody>
    </table>
</div>
