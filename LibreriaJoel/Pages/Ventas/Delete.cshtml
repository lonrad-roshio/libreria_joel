@page "{id:int}"
@model LibreriaJoel.Pages.Ventas.DeleteModel
@{
    ViewData["Title"] = "Eliminar venta";
}

<h1 class="h4 mb-3 text-danger">Eliminar venta</h1>

<div class="card card-modulo">
    <div class="card-body">
        <p>¿Está seguro de que desea eliminar la venta <strong>#@Model.Venta!.IdVenta</strong> del @Model.Venta.Fecha.ToString("dd/MM/yyyy")? El stock de los productos vendidos será restituido.</p>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Venta.IdVenta" />
            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>
